# Copy to .env (gitignored). Never commit real values.
POSTGRES_PORT=5432
POSTGRES_USER=processlens
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=processlens
DATABASE_URL=postgresql://processlens:change-me-locally@localhost:5432/processlens

MINIO_PORT=9000
MINIO_ROOT_USER=processlens
MINIO_ROOT_PASSWORD=change-me-locally

# Product AI service (services/ai only). Leave these empty until the owner sets them.
# With no key, find_target answers "unavailable" and a row parks exactly as it did before.
# DEEPSEEK_MODEL is the owner's choice and has no built-in default: with a key but no model the
# service is unavailable too, so a run never spends the owner's credit on a model they did not
# name. DEEPSEEK_ESCALATION_MODEL is the one retry when an answer fails its schema or a code gate;
# leave it empty to disable the retry.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_ESCALATION_MODEL=
GEMINI_API_KEY=
