# Copy to .env (gitignored). Never commit real values.
POSTGRES_PORT=5432
POSTGRES_USER=processlens
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=processlens
DATABASE_URL=postgresql://processlens:change-me-locally@localhost:5432/processlens

MINIO_PORT=9000
MINIO_ROOT_USER=processlens
MINIO_ROOT_PASSWORD=change-me-locally

# Product AI service (services/ai only). Leave the key empty until the owner's credits are ready;
# with no key, find_target answers "unavailable" and a row parks exactly as it did before.
# DeepSeek's Flash model is the trial's default. The Pro model is the one retry when an answer
# fails its schema or a code gate; leave DEEPSEEK_ESCALATION_MODEL empty to disable that retry.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_ESCALATION_MODEL=deepseek-v4-pro
GEMINI_API_KEY=
