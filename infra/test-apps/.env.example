# PL-022 test apps — logins and settings for the two local test apps.
#
# Test values only. These open nothing but Odoo and Twenty on 127.0.0.1, and the
# keys are throwaway; never reuse any of them for a real deployment.
#
# A fresh clone needs no setup: docker-compose.yml carries the same values as
# defaults, and reset.py reads this file when .env is absent. Copy to .env
# (gitignored) to override anything below without touching a committed file.

# --------------------------------------------------------------------- Odoo ---
# URL:      http://localhost:8069
# Login:    admin
ODOO_HTTP_PORT=8069
ODOO_DB_NAME=processlens_test
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo-test-password
# Odoo's database master password (config key admin_passwd); used by the seeder
# to create the database over XML-RPC.
ODOO_MASTER_PASSWORD=admin
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=ProcessLensTest18
# The three seeded salespeople share this password:
#   sales1@processlens.test .. sales3@processlens.test
ODOO_SALES_PASSWORD=SalesDemoPass18

# ------------------------------------------------------------------- Twenty ---
# URL:      http://localhost:3000
# Login:    test@processlens.test
TWENTY_HTTP_PORT=3000
TWENTY_SERVER_URL=http://localhost:3000
TWENTY_DB_NAME=default
TWENTY_DB_USER=postgres
TWENTY_DB_PASSWORD=twenty-test-password
TWENTY_ENCRYPTION_KEY=cHJvY2Vzc2xlbnMtdGVzdC1lbmNyeXB0aW9uLWtleXM=
TWENTY_APP_SECRET=6f1c9b2a4d8e0f3b5a7c9d1e2f4a6b8c0d2e4f6a8b0c1d3e5f7a9b1c3d5e7f9a
TWENTY_WORKSPACE_NAME=ProcessLens Test
TWENTY_LOGIN_EMAIL=test@processlens.test
TWENTY_LOGIN_PASSWORD=ProcessLensTest20