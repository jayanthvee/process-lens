{
  "manifest_version": 3,
  "name": "ProcessLens Recorder",
  "version": "0.1.0",
  "description": "Records a browser demonstration as semantic, replayable steps.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "debugger", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/recorder.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "ProcessLens Recorder",
    "default_popup": "popup/popup.html"
  }
}
