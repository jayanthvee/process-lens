{
  "name": "process-lens-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome Manifest V3 recorder that captures a demonstration as semantic steps.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node scripts/validate-package.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "make-key": "node scripts/make-key.mjs",
    "extension-id": "node scripts/extension-id.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run validate"
  },
  "devDependencies": {
    "@fontsource/public-sans": "5.3.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
